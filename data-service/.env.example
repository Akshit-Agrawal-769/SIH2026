# Where the built data catalog lives (tiles/, api/, data/). Defaults: /app/data in the
# container image, ../frontend/public in a repository checkout.
OCEAN_DATA_ROOT=
# Browser origins allowed to call the API directly (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Required to enable POST /api/instruments/ingest; leave empty to keep ingestion disabled
ADMIN_API_TOKEN=
# Optional storage backends (the API works without them)
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
ENABLE_MINIO=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ocean-data
MINIO_SECURE=false
