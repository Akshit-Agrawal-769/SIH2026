PORT=4000
NODE_ENV=development
DATA_SERVICE_URL=http://localhost:8000
# Comma-separated list of browser origins allowed to call the API (e.g. https://your-app.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Required only for mutating requests (POST ...) and the /ws/live channel. Scientific GETs are public.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Forwarded to the data-service for mutating requests (must equal the data-service ADMIN_API_TOKEN)
ADMIN_API_TOKEN=
# Optional admin login (POST /api/auth/login). Leave empty to disable login entirely.
ADMIN_USERNAME=
ADMIN_PASSWORD=
RATE_LIMIT_PER_MINUTE=600
