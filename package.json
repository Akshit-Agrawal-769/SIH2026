{
  "name": "incois-3d-ocean-platform",
  "version": "1.0.0",
  "private": true,
  "description": "INCOIS 3D Ocean Data Visualization & Analysis Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "build": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "python -m pytest backend/tests",
    "test": "npm run test:frontend && npm run test:backend",
    "start": "npm --prefix frontend run preview"
  }
}
