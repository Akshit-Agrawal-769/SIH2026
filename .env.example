# INCOIS 3D Ocean Data Visualization Platform — Root Configuration

# Gateway
PORT=4000
NODE_ENV=development
DATA_SERVICE_URL=http://data-service:8000
GATEWAY_PORT=4000

# Frontend
FRONTEND_PORT=3001
VITE_GATEWAY_URL=http://localhost:4000
VITE_CESIUM_ION_TOKEN=

# Data Service (FastAPI)
DATA_SERVICE_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgresql://incois_user:incois_password@postgres:5432/incois_ocean
REDIS_URL=redis://redis:6379/0

# Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ocean-data
MINIO_SECURE=false

# Postgres
POSTGRES_USER=incois_user
POSTGRES_PASSWORD=incois_password
POSTGRES_DB=incois_ocean
POSTGRES_PORT=5432
